# ── LLM (OpenRouter) ─────────────────────────────────────────────
# https://openrouter.ai/keys adresinden aldığınız anahtarı buraya yazın
LLM_API_KEY=

# OpenRouter uç noktası (değiştirmeyin)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Kullanılacak model (OpenRouter model kimliği)
# Örnekler: openai/gpt-4o-mini, anthropic/claude-3.5-haiku, google/gemini-2.0-flash-001
LLM_MODEL=openai/gpt-4o-mini

# ── Sunucu ───────────────────────────────────────────────────────
PORT=3000
